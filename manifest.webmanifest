      "icons": [
        {
          "src": "icons/goldy-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Open Production View",
      "short_name": "View",
      "description": "Jump to the generated production view.",
      "url": "./index.html#output",
      "icons": [
        {
          "src": "icons/goldy-icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
